{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build -p web gateway github-svc ai-svc review-svc sync-svc",
    "prestart": "node tools/ensure-electron.mjs",
    "start": "npm run build && electron apps/desktop/main.js",
    "predesktop": "node tools/ensure-electron.mjs",
    "desktop": "electron apps/desktop/main.js",
    "dev": "nx run-many -t serve -p gateway github-svc ai-svc review-svc sync-svc web",
    "dev:web": "nx serve web",
    "typecheck": "nx run-many -t typecheck -p web gateway github-svc ai-svc review-svc sync-svc server contracts markdown",
    "smoke": "node tools/smoke.mjs",
    "seed:demo": "node --experimental-strip-types tools/seed-demo.mjs",
    "postinstall": "node tools/ensure-electron.mjs"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/js": "24.0.0",
    "@nx/nest": "^24.0.0",
    "@nx/node": "24.0.0",
    "@nx/react": "^24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/webpack": "24.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.3",
    "jiti": "2.4.2",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.0"
  }
}
